---
import { ArrowRight, Play } from '@lucide/astro'
import { SITE } from '../lib/site'
import DocsLink from './DocsLink.astro';
---

<section class="border-b border-border">
  <div
    class="mx-auto max-w-3xl px-5 py-24 text-center sm:px-8 sm:py-32"
  >
    <h2
      class="reveal text-balance text-4xl font-semibold tracking-tight sm:text-6xl"
      style="--reveal-delay: 80ms"
    >
      Push your first run.
    </h2>
    <p
      class="reveal mx-auto mt-5 max-w-xl text-pretty text-lg text-muted-foreground"
      style="--reveal-delay: 140ms"
    >
      Add the reporter, point it at a kinora server, and watch the history build
      itself.
    </p>
    <div
      class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
      style="--reveal-delay: 200ms"
    >
      <a
        href={SITE.signup}
        data-umami-event="get-started-cta"
        class="inline-flex h-11 items-center gap-2 rounded-md bg-signal px-6 text-sm font-semibold text-background transition-opacity hover:opacity-90"
      >
        Get started
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
      <a
        href={SITE.demo}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="live-demo-cta"
        class="inline-flex h-11 items-center gap-2 rounded-md border border-border px-6 text-sm font-semibold transition-colors hover:bg-muted"
      >
        <Play class="size-4" aria-hidden="true" />
        Live demo
      </a>
    </div>
    <p class="reveal mt-6" style="--reveal-delay: 260ms">
      <DocsLink href={SITE.docs} event="docs-cta">Or read the docs</DocsLink>
    </p>
  </div>
</section>
