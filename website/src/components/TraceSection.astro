---
import { Clock, CodeXml, FileUp, Globe, Sparkles, SquareTerminal } from '@lucide/astro'
import traceDark from '../assets/screenshots/trace-viewer-dark.png'
import traceLight from '../assets/screenshots/trace-viewer-light.png'
import { SITE } from '../lib/site'
import Screenshot from './Screenshot.astro'

const chips = [
  { icon: CodeXml, label: 'DOM snapshots' },
  { icon: Globe, label: 'Network' },
  { icon: SquareTerminal, label: 'Console' },
  { icon: Clock, label: 'Timeline' },
  { icon: Sparkles, label: 'Copy prompt' },
];
---

<section
  id="trace"
  class="relative overflow-hidden border-b border-border bg-card/30"
>
  <div
    class="app-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(100%_60%_at_50%_100%,black,transparent)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto max-w-7xl px-5 py-20 text-center sm:px-8 sm:py-28"
  >
    <p
      class="reveal font-mono text-xs font-medium uppercase tracking-wider text-signal"
    >
      [ Trace viewer ]
    </p>
    <h2
      class="reveal mx-auto mt-4 max-w-3xl text-balance text-3xl font-semibold tracking-tight sm:text-5xl"
      style="--reveal-delay: 80ms"
    >
      When a test fails, the trace is right there.
    </h2>
    <p
      class="reveal mx-auto mt-5 max-w-2xl text-pretty text-lg text-muted-foreground"
      style="--reveal-delay: 140ms"
    >
      Failing tests get a <span class="font-medium text-foreground">View trace</span
      > button that opens the full Playwright trace inline, DOM, timeline, network
      and console, no download, no separate tooling. The replay engine is vendored
      straight from Playwright, so it is the viewer you already know.
    </p>

    <div
      class="reveal mx-auto mt-8 flex flex-wrap items-center justify-center gap-2.5"
      style="--reveal-delay: 200ms"
    >
      {
        chips.map((c) => {
          const Icon = c.icon
          return (
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-background/60 py-1.5 pl-3 pr-3.5 font-mono text-xs text-muted-foreground">
              <Icon class="size-3.5 text-signal" aria-hidden="true" />
              {c.label}
            </span>
          )
        })
      }
    </div>

    <div
      class="reveal mt-10 flex flex-col items-center gap-3"
      style="--reveal-delay: 240ms"
    >
      <a
        href={SITE.traceViewer}
        data-umami-event="open-trace-viewer-home"
        class="inline-flex h-11 items-center gap-2 rounded-md bg-signal px-6 font-mono text-sm font-semibold text-background transition-opacity hover:opacity-90"
      >
        <FileUp class="size-4" aria-hidden="true" />
        Open a trace
      </a>
      <p class="text-xs text-muted-foreground">
        No account. The file stays in your browser.
      </p>
    </div>

    <div class="reveal mt-14" style="--reveal-delay: 120ms">
      <Screenshot
        light={traceLight}
        dark={traceDark}
        label="kinora.dev/trace"
        alt="Embedded Playwright trace viewer showing the action timeline, a DOM snapshot, and the failing assertion in the source"
        class="mx-auto max-w-5xl"
      />
    </div>
  </div>
</section>
