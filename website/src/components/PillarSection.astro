---
import type { Pillar } from '../data/pillars'
import DocsLink from './DocsLink.astro'
import PillarHeader from './PillarHeader.astro'
import Screenshot from './Screenshot.astro'

interface Props { pillar: Pillar }
const { pillar } = Astro.props
const [lead, ...rest] = pillar.items
---

<section id={pillar.id} class="border-b border-border">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <PillarHeader pillar={pillar} />

    {/* The lead item gets a full row, the others share a grid below it. */}
    {lead && (
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="reveal">
          <p class="text-sm font-medium text-signal">{lead.eyebrow}</p>
          <h3 class="mt-3 text-balance text-2xl font-semibold tracking-tight sm:text-3xl">{lead.title}</h3>
          <p class="mt-4 text-pretty text-base leading-relaxed text-muted-foreground">{lead.body}</p>
          {lead.docs && <div class="mt-4"><DocsLink href={lead.docs.href} event={lead.docs.event}>{lead.docs.label}</DocsLink></div>}
        </div>
        <div class="reveal" style="--reveal-delay: 120ms">
          <Screenshot light={lead.light} dark={lead.dark} alt={lead.alt} />
        </div>
      </div>
    )}

    <div class="mt-14 grid gap-6 sm:mt-20 md:grid-cols-2">
      {
        rest.map((item, i) => (
          <article
            class="reveal flex flex-col rounded-2xl border border-border bg-card/30 p-6 sm:p-8"
            style={`--reveal-delay: ${(i % 2) * 90}ms`}
          >
            <p class="text-sm font-medium text-signal">{item.eyebrow}</p>
            <h3 class="mt-2 text-balance text-xl font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 text-pretty text-sm leading-relaxed text-muted-foreground">{item.body}</p>
            {item.docs && <div class="mt-3"><DocsLink href={item.docs.href} event={item.docs.event}>{item.docs.label}</DocsLink></div>}
            <div class="mt-auto pt-6">
              <Screenshot light={item.light} dark={item.dark} alt={item.alt} />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
