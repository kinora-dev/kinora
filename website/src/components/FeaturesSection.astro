---
import a11yDark from '../assets/screenshots/a11y-dark.png'
import a11yLight from '../assets/screenshots/a11y-light.png'
import analyticsDark from '../assets/screenshots/analytics-dark.png'
import analyticsLight from '../assets/screenshots/analytics-light.png'
import compareDark from '../assets/screenshots/compare-dark.png'
import compareLight from '../assets/screenshots/compare-light.png'
import componentsDark from '../assets/screenshots/components-dark.png'
import componentsLight from '../assets/screenshots/components-light.png'
import projectDark from '../assets/screenshots/project-dark.png'
import projectLight from '../assets/screenshots/project-light.png'
import testHistoryDark from '../assets/screenshots/test-history-dark.png'
import testHistoryLight from '../assets/screenshots/test-history-light.png'
import testsDark from '../assets/screenshots/tests-dark.png'
import testsLight from '../assets/screenshots/tests-light.png'
import Screenshot from './Screenshot.astro'

const features = [
  {
    eyebrow: 'Trends over time',
    title: 'Every run, one strip at a time.',
    body: 'Push from CI and kinora keeps the history. Pass rate, run count, and duration per project, with a sparkline trend and one colored strip per run, so a slow drift is obvious long before it breaks the build.',
    light: projectLight,
    dark: projectDark,
    label: 'kinora.dev/project/checkout-api',
    alt: 'Per-project page with pass rate, trend sparkline and per-run history strips',
  },
  {
    eyebrow: 'Analytics',
    title: 'Is the suite getting better or worse?',
    body: 'The share of passed, flaky and failed results over the last 30 or 90 days, per day or per week, for every branch or just one. A flaky rate creeping up shows here weeks before anyone complains about CI.',
    light: analyticsLight,
    dark: analyticsDark,
    label: 'kinora.dev/project/web-app/analytics',
    alt: 'Analytics page with a stacked chart of the share of passed, flaky and failed test results per week over 90 days',
  },
  {
    eyebrow: 'Flaky or broken',
    title: 'Tell flaky tests from broken ones.',
    body: 'Playwright only calls a test flaky when it passes on a retry. kinora also catches the ones that pass and fail on the same commit, or keep flipping from one run to the next, and tells them apart from broken tests: the ones that fail and keep failing since a commit. Each badge says why.',
    light: testsLight,
    dark: testsDark,
    label: 'kinora.dev/project/checkout-api/tests',
    alt: 'Tests page listing flaky and broken tests with their flaky rate, fail rate and run history',
  },
  {
    eyebrow: 'Per-test history',
    title: 'Follow a single test across runs.',
    body: 'Each test keeps a stable identity regardless of how it was uploaded, so you can track one test run-to-run: when it started flaking, when it was fixed, and how long it has been green.',
    light: testHistoryLight,
    dark: testHistoryDark,
    label: 'kinora.dev/test/refunds-an-order',
    alt: 'Per-test history with a status timeline, pass and flaky rates, and a list of failures and flakes',
  },
  {
    eyebrow: 'Run-to-run diff',
    title: 'See exactly what changed between two runs.',
    body: 'Pick any two runs and kinora groups every difference for you: newly failing, fixed, newly flaky, and still failing. No more diffing two HTML reports by eye to find the one test that regressed since green.',
    light: compareLight,
    dark: compareDark,
    label: 'kinora.dev/project/checkout-api/compare',
    alt: 'Run comparison page grouping tests into newly failing, fixed, newly flaky and still failing, with pass-rate delta',
  },
  {
    eyebrow: 'Component health',
    title: 'Every story of your design system, run after run.',
    body: 'Storybook stories run by Vitest and Playwright component tests are grouped by component and story, each with its status and history. See at a glance which component regressed and which story keeps flaking, then open the tests behind it.',
    light: componentsLight,
    dark: componentsDark,
    label: 'kinora.dev/project/design-system/components',
    alt: 'Components page with accessibility hotspots and each component listed with its stories, their status and a run history timeline',
  },
  {
    eyebrow: 'Accessibility',
    title: 'Know where accessibility breaks, and how badly.',
    body: 'kinora reads the axe scans of your Playwright tests and of your Storybook stories: the rules broken, their impact, the elements they hit. Hotspots rank your test files and components by their violations, critical ones first, so you know where fixing pays off.',
    light: a11yLight,
    dark: a11yDark,
    label: 'kinora.dev/project/web-app/tests',
    alt: 'Tests page with accessibility hotspots ranking test files by axe violations and their impact, and the tests breaking a rule',
  },
];
---

<section id="features" class="border-b border-border">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <header class="reveal mb-16 max-w-3xl">
      <h2
        class="text-balance text-3xl font-semibold tracking-tight sm:text-5xl"
      >
        One level up from the HTML report.
      </h2>
    </header>

    <div class="flex flex-col gap-20 sm:gap-28">
      {
        features.map((f, i) => {
          return (
            <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
              <div class={`reveal ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
                <p class="text-sm font-medium text-signal">
                  {f.eyebrow}
                </p>
                <h3 class="mt-3 text-balance text-2xl font-semibold tracking-tight sm:text-3xl">
                  {f.title}
                </h3>
                <p class="mt-4 text-pretty text-base leading-relaxed text-muted-foreground">
                  {f.body}
                </p>
              </div>
              <div
                class={`reveal ${i % 2 === 1 ? 'lg:order-1' : ''}`}
                style="--reveal-delay: 120ms"
              >
                <Screenshot
                  light={f.light}
                  dark={f.dark}
                  label={f.label}
                  alt={f.alt}
                />
              </div>
            </div>
          )
        })
      }
    </div>
  </div>
</section>
