---
import { Check, Copy } from '@lucide/astro'
import { Code } from 'astro:components'

interface Props {
  code: string
  lang?: 'ts' | 'bash' | 'json'
  filename?: string
  class?: string
  event?: string
}
const { code, lang, filename, class: klass = '', event }: Props = Astro.props;
---

<div
  class={`overflow-hidden rounded-lg border border-border bg-card/60 ${klass}`}
  data-copy-root
  data-copy={code}
>
  {
    filename && (
      <div class="border-b border-border/80 px-4 py-2 font-mono text-[11px] text-muted-foreground">
        {filename}
      </div>
    )
  }
  <div class="relative">
    {/* Right padding keeps the last characters of a long line clear of the copy button. */}
    <div class="overflow-x-auto py-3.5 pl-4 pr-11 text-[13px] leading-relaxed">
      {
        lang
? (
          <Code
            code={code}
            lang={lang}
            themes={{ light: 'vitesse-light', dark: 'vitesse-dark' }}
            defaultColor={false}
          />
        )
: (
          <pre class="font-mono text-muted-foreground"><code>{code}</code></pre>
        )
      }
    </div>
    <button
      type="button"
      data-copy-btn
      data-umami-event={event}
      aria-label="Copy code"
      class="absolute right-2 top-2 grid size-7 place-items-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <Copy class="size-3.5 [[data-copied]_&]:hidden" aria-hidden="true" />
      <Check
        class="hidden size-3.5 text-pass [[data-copied]_&]:block"
        aria-hidden="true"
      />
    </button>
  </div>
</div>

<script is:inline>
document.querySelectorAll('[data-copy-root]').forEach((root) => {
  if (root.dataset.copyBound)
    return
  root.dataset.copyBound = '1'
  const btn = root.querySelector('[data-copy-btn]')
  const text
    = root.getAttribute('data-copy')
      ?? root.querySelector('[data-copy-text]')?.textContent
      ?? ''
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(text)
      btn.setAttribute('data-copied', '')
      setTimeout(() => btn.removeAttribute('data-copied'), 1600)
    }
    catch {}
  })
})
</script>
