---
import { ChevronDown } from '@lucide/astro'
import { COMPARISONS } from '../data/comparisons'
import { HOME_FAQS as faqs } from '../data/faq'
import DocsLink from './DocsLink.astro'
---

<section id="faq" class="border-b border-border">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <header class="reveal mb-12 max-w-3xl">
      <p
        class="font-mono text-xs font-medium uppercase tracking-wider text-signal"
      >
        [ FAQ ]
      </p>
      <h2
        class="mt-4 text-balance text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        Questions, answered.
      </h2>
    </header>

    <div
      class="reveal mx-auto flex max-w-3xl flex-col gap-px overflow-hidden rounded-xl border border-border bg-border"
    >
      {
        faqs.map(f => (
          <details class="group bg-background">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left font-medium tracking-tight transition-colors hover:bg-muted/40 [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <ChevronDown
                class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
                aria-hidden="true"
              />
            </summary>
            <p class="px-6 pb-5 text-pretty leading-relaxed text-muted-foreground">
              {f.a}
            </p>
            {f.docs && (
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 px-6 pb-5">
                {f.docs.map(d => (
                  <DocsLink href={d.href} event={d.event}>
                    {d.label}
                  </DocsLink>
                ))}
              </div>
            )}
          </details>
        ))
      }
    </div>

    <div class="reveal mx-auto mt-8 flex max-w-3xl flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
      <span class="font-mono text-[11px] uppercase tracking-wider">Compare:</span>
      {
        COMPARISONS.map(c => (
          <a
            href={`/vs/${c.slug}`}
            class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
          >
            vs {c.themShort}
          </a>
        ))
      }
    </div>
  </div>
</section>
