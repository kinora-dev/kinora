---
import { DOCS, SITE } from '../lib/site'
import CodeBlock from './CodeBlock.astro'

const configSnippet = `export default defineConfig({
  reporter: [['@kinora/reporter', { project: { slug: 'web-app' } }]],
  // enable tracing so View trace works
  use: { trace: 'on-first-retry' },
})`

const runSnippet = `KINORA_TOKEN=<token> npx playwright test`

const aiPrompt = `Set up kinora Playwright reporting in this repository.
Read ${SITE.url}/llms/setup.md and follow it.`

const steps: {
  num: string
  title: string
  body: string
  code: string | null
  filename: string | null
  lang: 'ts' | 'bash' | null
}[] = [
  {
    num: '01',
    title: 'Add the reporter',
    body: 'One line in your Playwright config. It auto-uploads at the end of every run.',
    code: configSnippet,
    filename: 'playwright.config.ts',
    lang: 'ts',
  },
  {
    num: '02',
    title: 'Add your token',
    body: 'Pass a project token by env, kept out of the config and in CI secrets.',
    code: runSnippet,
    filename: 'CI',
    lang: null,
  },
  {
    num: '03',
    title: 'Watch the dashboard',
    body: 'Pass rates, trends, flaky tests and full traces land in kinora, one strip per run.',
    code: null,
    filename: null,
    lang: null,
  },
];
---

<section id="setup" class="border-b border-border">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div
      class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20"
    >
      <header class="reveal lg:sticky lg:top-24 lg:self-start">
        <p
          class="font-mono text-xs font-medium uppercase tracking-wider text-signal"
        >
          [ Setup ]
        </p>
        <h2
          class="mt-4 text-balance text-3xl font-semibold tracking-tight sm:text-5xl"
        >
          Two ways in. Both take a minute.
        </h2>
        <p
          class="mt-5 text-pretty text-base leading-relaxed text-muted-foreground"
        >
          The reporter is the quick path. Prefer to upload an existing <code
            class="rounded bg-muted px-1.5 py-0.5 font-mono text-[13px]"
                                                                       >results.json</code
          >
          from a separate job? The CLI does the same, and both share <code
            class="rounded bg-muted px-1.5 py-0.5 font-mono text-[13px]"
                                                                     >@kinora/core</code
          >
          so a test keeps a stable identity across runs and ingest methods.
        </p>
        <a
          href={DOCS.gettingStarted}
          data-umami-event="setup-docs"
          class="mt-6 inline-flex items-center gap-1.5 font-mono text-sm font-medium text-signal underline-offset-4 hover:underline"
        >
          Read the docs &rarr;
        </a>
      </header>

      <div class="flex flex-col gap-10">
        <div class="reveal rounded-xl border border-signal/30 bg-signal/[0.04] p-5 sm:p-6">
          <h3 class="text-lg font-semibold tracking-tight">
            Let your coding agent do it
          </h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
            Paste this into Claude Code, Cursor, or any agent. It reads the setup
            doc and wires the reporter into your config.
          </p>
          <CodeBlock code={aiPrompt} filename="Prompt" event="copy-setup-ai" class="mt-3.5" />
          <a
            href={`${SITE.url}/llms/setup.md`}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="setup-doc"
            class="mt-4 inline-flex items-center gap-1.5 font-mono text-sm font-medium text-signal underline-offset-4 hover:underline"
          >
            View the setup doc &rarr;
          </a>
        </div>

        <div class="flex items-center gap-3">
          <span class="h-px flex-1 bg-border" />
          <span class="font-mono text-xs uppercase tracking-wider text-muted-foreground">
            or set it up by hand
          </span>
          <span class="h-px flex-1 bg-border" />
        </div>

        <ol class="flex flex-col gap-8">
        {
          steps.map((s, i) => (
            <li class="reveal flex gap-5" style={`--reveal-delay: ${i * 80}ms`}>
              <span class="flex size-9 shrink-0 items-center justify-center rounded-md border border-signal/30 bg-signal/10 font-mono text-xs font-semibold text-signal">
                {s.num}
              </span>
              <div class="min-w-0 flex-1 pt-1">
                <h3 class="text-lg font-semibold tracking-tight">{s.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                  {s.body}
                </p>
                {s.code && (
                  <CodeBlock
                    code={s.code}
                    lang={s.lang ?? undefined}
                    filename={s.filename ?? undefined}
                    event={`copy-setup-${s.num}`}
                    class="mt-3.5"
                  />
                )}
              </div>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </div>
</section>
