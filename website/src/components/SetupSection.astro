---
import { DOCS, SITE } from '../lib/site'
import CodeBlock from './CodeBlock.astro'

const configSnippet = `export default defineConfig({
  reporter: [['@kinora/reporter', { project: { slug: 'web-app' } }]],
  // enable tracing so View trace works
  use: { trace: 'on-first-retry' },
})`

const runSnippet = `KINORA_TOKEN=<token> npx playwright test`

const aiPrompt = `Set up kinora test reporting in this repository.
Read ${SITE.url}/llms/setup.md and follow it.`

const steps = [
  {
    num: '01',
    title: 'Add the reporter',
    body: 'One line in your Playwright config. It auto-uploads at the end of every run.',
    code: configSnippet,
    filename: 'playwright.config.ts',
    lang: 'ts' as const,
  },
  {
    num: '02',
    title: 'Add your token, run your tests',
    body: 'A project token by env, kept in CI secrets. Pass rates, flaky tests and traces land in kinora.',
    code: runSnippet,
    filename: 'CI',
    lang: undefined,
  },
];
---

<section id="setup" class="border-b border-border">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div
      class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20"
    >
      <header class="reveal lg:sticky lg:top-24 lg:self-start">
        <h2
          class="text-balance text-3xl font-semibold tracking-tight sm:text-5xl"
        >
          Set up in a minute.
        </h2>
        <p
          class="mt-5 text-pretty text-base leading-relaxed text-muted-foreground"
        >
          The reporter is the quick path. Prefer to upload an existing <code
            class="rounded bg-muted px-1.5 py-0.5 font-mono text-[13px]"
                                                                       >results.json</code
          >
          from a separate job? The CLI does the same, and both share <code
            class="rounded bg-muted px-1.5 py-0.5 font-mono text-[13px]"
                                                                     >@kinora/core</code
          >
          so a test keeps a stable identity across runs and ingest methods.
        </p>
        <a
          href={DOCS.gettingStarted}
          data-umami-event="setup-docs"
          class="mt-6 inline-flex items-center gap-1.5 font-mono text-sm font-medium text-signal underline-offset-4 hover:underline"
        >
          Read the docs &rarr;
        </a>
      </header>

      <div class="reveal" data-tabs>
        <div role="tablist" aria-label="How to set up kinora" class="inline-flex rounded-lg border border-border bg-muted/40 p-1">
          {
            [['manual', 'By hand'], ['agent', 'With your coding agent']].map(([id, label], i) => (
              <button
                type="button"
                role="tab"
                id={`setup-tab-${id}`}
                aria-controls={`setup-panel-${id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={id}
                class="rounded-md px-3.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-sm"
              >
                {label}
              </button>
            ))
          }
        </div>

        {/* Stacked in one cell, so switching tabs never moves the page; hidden by class, not removed,
            so both panels stay in the HTML for readers and crawlers. */}
        <div class="mt-6 grid grid-cols-1">
        <ol id="setup-panel-manual" role="tabpanel" aria-labelledby="setup-tab-manual" data-panel="manual" class="flex flex-col gap-6 [grid-area:1/1]">
          {
            steps.map(s => (
              <li class="flex gap-4">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-md border border-signal/30 bg-signal/10 font-mono text-xs font-semibold text-signal">
                  {s.num}
                </span>
                <div class="min-w-0 flex-1 pt-0.5">
                  <h3 class="text-base font-semibold tracking-tight">{s.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{s.body}</p>
                  <CodeBlock code={s.code} lang={s.lang} filename={s.filename} event={`copy-setup-${s.num}`} class="mt-3" />
                </div>
              </li>
            ))
          }
        </ol>

        <div id="setup-panel-agent" role="tabpanel" aria-labelledby="setup-tab-agent" data-panel="agent" class="invisible [grid-area:1/1]">
          <h3 class="text-base font-semibold tracking-tight">Let your coding agent do it</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
            Paste this into Claude Code, Cursor, or any agent. It reads the setup doc and wires the
            reporter into your config.
          </p>
          <CodeBlock code={aiPrompt} filename="Prompt" event="copy-setup-ai" class="mt-3" />
          <a
            href={`${SITE.url}/llms/setup.md`}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="setup-doc"
            class="mt-4 inline-flex items-center gap-1.5 font-mono text-sm font-medium text-signal underline-offset-4 hover:underline"
          >
            View the setup doc &rarr;
          </a>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        root.querySelector(`[data-panel="${t.dataset.tab}"]`)?.classList.toggle('invisible', !on)
      }
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab))
      // Arrow keys move between tabs, as in the WAI-ARIA tabs pattern.
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (!step)
          return
        const next = tabs[(i + step + tabs.length) % tabs.length]
        select(next)
        next.focus()
      })
    })
  }
</script>
