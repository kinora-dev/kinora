---
import { Menu, X } from '@lucide/astro'
import { NAV, SITE } from '../lib/site'
import GithubIcon from './GithubIcon.astro'
import Wordmark from './Wordmark.astro';
---

<header
  class="sticky top-0 z-40 border-b border-border/80 bg-background/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-5 sm:px-8">
    <a href="/" class="shrink-0" aria-label="kinora home">
      <Wordmark size="sm" />
    </a>

    <nav class="ml-6 hidden items-center gap-1 lg:flex">
      {
        NAV.map(item => (
          <a
            href={item.href}
            data-umami-event={item.event}
            class="rounded-md px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="github-header"
        class="grid size-9 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="kinora on GitHub"
      >
        <GithubIcon class="size-4" />
      </a>
      <a
        href={SITE.demo}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="live-demo-header"
        class="hidden h-9 items-center rounded-md px-3 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:inline-flex"
      >
        Demo
      </a>
      <a
        href={SITE.login}
        data-umami-event="signin-header"
        class="inline-flex h-9 items-center rounded-md px-3 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        Sign in
      </a>
      <a
        href={SITE.signup}
        data-umami-event="get-started-header"
        class="hidden h-9 items-center rounded-md bg-signal px-4 text-xs font-semibold text-background transition-opacity hover:opacity-90 sm:inline-flex"
      >
        Get started
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-nav"
        aria-expanded="false"
        class="group grid size-9 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground lg:hidden"
      >
        <Menu class="size-4 group-aria-expanded:hidden" aria-hidden="true" />
        <X class="hidden size-4 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    hidden
    aria-label="Mobile"
    class="border-t border-border/80 bg-background px-5 py-3 lg:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        NAV.map(item => (
          <a
            href={item.href}
            data-umami-event={item.event}
            class="rounded-md px-3 py-2.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={SITE.signup}
        data-umami-event="get-started-mobile"
        class="mt-2 inline-flex h-10 items-center justify-center rounded-md bg-signal px-4 text-xs font-semibold text-background transition-opacity hover:opacity-90"
      >
        Get started
      </a>
    </div>
  </nav>
</header>

<script is:inline>
const btn = document.getElementById('mobile-menu-btn')
const panel = document.getElementById('mobile-nav')
if (btn && panel) {
  const close = () => {
    panel.setAttribute('hidden', '')
    btn.setAttribute('aria-expanded', 'false')
    btn.setAttribute('aria-label', 'Open menu')
  }
  btn.addEventListener('click', () => {
    if (panel.hasAttribute('hidden')) {
      panel.removeAttribute('hidden')
      btn.setAttribute('aria-expanded', 'true')
      btn.setAttribute('aria-label', 'Close menu')
    }
    else {
      close()
    }
  })
  panel
    .querySelectorAll('a')
    .forEach(a => a.addEventListener('click', close))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hasAttribute('hidden'))
      close()
  })
}
</script>
