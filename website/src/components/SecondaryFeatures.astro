---
import { DOCS } from '../lib/site'
import DocsLink from './DocsLink.astro'

const items: {
  title: string
  body: string
  docs?: { label: string, href: string, event: string }[]
}[] = [
  {
    title: 'PR comments',
    body: 'Post a run summary on the GitHub PR or GitLab MR straight from CI: pass/fail, tests newly failing vs the base branch, one click to the trace.',
    docs: [{ label: 'PR comments', href: DOCS.prComments, event: 'docs-pr-comments' }],
  },
  {
    title: 'Branch & tag filters',
    body: 'Slice the overview by branch or tag to compare main against a feature branch, or smoke against nightly.',
  },
  {
    title: 'Reporter, Vitest or CLI',
    body: 'Auto-upload at the end of every Playwright or Vitest run, or push an existing results.json from a separate CI job. Same data either way.',
    docs: [
      { label: 'Reporter', href: DOCS.reporter, event: 'docs-reporter' },
      { label: 'Vitest', href: DOCS.vitest, event: 'docs-vitest' },
      { label: 'CLI', href: DOCS.cli, event: 'docs-cli' },
    ],
  },
  {
    title: 'Stable test identity',
    body: 'A test keeps the same key across runs and ingest paths, so its history never silently breaks.',
  },
  {
    title: 'Slack, email & webhook alerts',
    body: 'Hear about new failures and regressions where the team already is, on every run or only when something breaks.',
    docs: [{ label: 'Alerts', href: DOCS.alerts, event: 'docs-alerts' }],
  },
  {
    title: 'Self-hosted, fair source',
    body: 'Your results stay on your own box. FSL server and dashboard, MIT client libraries you embed.',
    docs: [{ label: 'Self-hosting', href: DOCS.selfHosting, event: 'docs-self-hosting' }],
  },
];
---

<section class="border-b border-border">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <header class="reveal mb-12 max-w-3xl">
      <h2
        class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        Fits the CI you already have.
      </h2>
    </header>

    <div
      class="grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        items.map((item, i) => {
          return (
            <article
              class="reveal bg-background p-7"
              style={`--reveal-delay: ${(i % 3) * 70}ms`}
            >
              <h3 class="text-base font-semibold tracking-tight">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {item.body}
              </p>
              {item.docs && (
                <div class="mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-1.5">
                  {item.docs.map(d => (
                    <DocsLink href={d.href} event={d.event}>
                      {d.label}
                    </DocsLink>
                  ))}
                </div>
              )}
            </article>
          )
        })
      }
    </div>
  </div>
</section>
