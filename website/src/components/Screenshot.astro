---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  alt: string
  loading?: 'eager' | 'lazy'
  class?: string
}

const { light, dark, alt, loading = 'lazy', class: klass = '' }: Props = Astro.props

// One <picture>, browser fetches only the theme it needs (was 2 <img>, both downloaded).
const widths = [480, 768, 1024, 1440]
const sizes = '(min-width: 1024px) 64rem, 100vw'
const lightImg = await getImage({ src: light, format: 'webp', widths, sizes })
const darkImg = await getImage({ src: dark, format: 'webp', widths, sizes })
---

<figure class={`overflow-hidden rounded-xl border border-border bg-card shadow-lg ${klass}`}>
  <picture>
    <source srcset={darkImg.srcSet.attribute} sizes={sizes} media="(prefers-color-scheme: dark)" />
    <img
      src={lightImg.src}
      srcset={lightImg.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      loading={loading}
      decoding={loading === 'eager' ? 'auto' : 'async'}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      width={light.width}
      height={light.height}
      class="block w-full"
    />
  </picture>
</figure>
