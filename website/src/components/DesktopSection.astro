---
import { Download } from '@lucide/astro'
import { Image } from 'astro:assets'
import desktopDark from '../assets/screenshots/desktop-dark.png'
import desktopLight from '../assets/screenshots/desktop-light.png'
import { DOCS, SITE } from '../lib/site'
import DocsLink from './DocsLink.astro'
---

<section id="desktop" class="border-b border-border">
  <div
    class="mx-auto max-w-7xl px-5 py-20 text-center sm:px-8 sm:py-28"
  >
    <h2
      class="reveal mx-auto max-w-3xl text-balance text-3xl font-semibold tracking-tight sm:text-5xl"
      style="--reveal-delay: 80ms"
    >
      Go from a red test to a fix without leaving your desk.
    </h2>
    <p
      class="reveal mx-auto mt-5 max-w-2xl text-pretty text-lg text-muted-foreground"
      style="--reveal-delay: 140ms"
    >
      The kinora desktop app signs into your account and opens straight on the
      latest run's failures. <span class="font-medium text-foreground">Re-run</span
      > a failing test locally with your repo's own Playwright, jump to the
      <span class="font-medium text-foreground">source in your editor</span>,
      copy a ready-to-paste <span class="font-medium text-foreground">AI prompt</span
      >, or open the full <span class="font-medium text-foreground">trace inline</span
      >. It also opens any local <code class="font-mono text-sm">trace.zip</code
      > with no account at all.
    </p>

    <div
      class="reveal mt-9 flex flex-col items-center gap-3"
      style="--reveal-delay: 240ms"
    >
      <a
        href={SITE.download}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="download-desktop"
        class="inline-flex h-11 items-center gap-2 rounded-md bg-signal px-6 text-sm font-semibold text-background transition-opacity hover:opacity-90"
      >
        <Download class="size-4" aria-hidden="true" />
        Download
      </a>
      <p class="font-mono text-xs text-muted-foreground">
        macOS &middot; Windows &middot; Linux
      </p>
      <DocsLink href={DOCS.desktop} event="docs-desktop" class="mt-1">
        Desktop guide
      </DocsLink>
    </div>

    <div class="reveal mt-14" style="--reveal-delay: 120ms">
      <Image
        src={desktopLight}
        alt="kinora desktop app showing a project's failing tests with re-run, open-in-editor, copy-prompt and view-trace actions"
        loading="lazy"
        class="mx-auto w-full max-w-5xl rounded-xl shadow-2xl dark:hidden"
      />
      <Image
        src={desktopDark}
        alt="kinora desktop app showing a project's failing tests with re-run, open-in-editor, copy-prompt and view-trace actions"
        loading="lazy"
        class="mx-auto hidden w-full max-w-5xl rounded-xl shadow-2xl dark:block"
      />
    </div>
  </div>
</section>
