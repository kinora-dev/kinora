---
import { COMPARISONS } from '../data/comparisons'
import { SOLUTIONS } from '../data/solutions'
import { SITE } from '../lib/site'
import GithubIcon from './GithubIcon.astro'
import Wordmark from './Wordmark.astro'

const year = new Date().getFullYear();
---

<footer class="bg-background">
  <div class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
    <div
      class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between"
    >
      <div class="max-w-xs">
        <Wordmark size="sm" />
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          A dashboard for your Playwright tests, across projects and over time,
          with an embedded trace viewer.
        </p>
      </div>

      <nav class="flex flex-wrap gap-12 font-mono text-sm sm:gap-16">
        <div class="flex flex-col gap-3">
          <span
            class="text-[11px] uppercase tracking-wider text-muted-foreground"
          >Product</span
          >
          <a
            href="/#features"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Features</a
          >
          <a
            href="/#trace"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Trace viewer</a
          >
          <a
            href="/#desktop"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Desktop</a
          >
          <a
            href="/#mcp"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Agents</a
          >
          <a
            href="/#pricing"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Pricing</a
          >
          <a
            href="/#setup"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Setup</a
          >
        </div>
        <div class="flex flex-col gap-3">
          <span
            class="text-[11px] uppercase tracking-wider text-muted-foreground"
          >Project</span
          >
          <a
            href={SITE.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground"
          >
            <GithubIcon class="size-3.5" />
            GitHub
          </a>
          <a
            href={SITE.docs}
            data-umami-event="docs-footer"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Docs</a
          >
          <a
            href="/blog"
            data-umami-event="blog-footer"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Blog</a
          >
          <a
            href="/rss.xml"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >RSS</a
          >
          <a
            href="/privacy"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Privacy</a
          >
          <a
            href="/terms"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Terms</a
          >
          <a
            href="/contact"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >Contact</a
          >
        </div>
        <div class="flex flex-col gap-3">
          <span
            class="text-[11px] uppercase tracking-wider text-muted-foreground"
          >Use cases</span
          >
          {
            SOLUTIONS.map(s => (
              <a
                href={`/${s.slug}`}
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                {s.eyebrow}
              </a>
            ))
          }
        </div>
        <div class="flex flex-col gap-3">
          <span
            class="text-[11px] uppercase tracking-wider text-muted-foreground"
          >Compare</span
          >
          {
            COMPARISONS.map(c => (
              <a
                href={`/vs/${c.slug}`}
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                vs {c.themShort}
              </a>
            ))
          }
          <a
            href="/vs"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >
            All comparisons
          </a>
        </div>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-border pt-6 font-mono text-[11px] uppercase tracking-wider text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <span>&copy; {year} Joris Gallot</span>
      <span>Fair source &middot; FSL-1.1 server &middot; MIT libraries</span>
    </div>
  </div>
</footer>
