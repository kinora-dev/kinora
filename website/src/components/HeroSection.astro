---
import { ArrowRight, Play } from '@lucide/astro'
import overviewDark from '../assets/screenshots/overview-dark.png'
import overviewLight from '../assets/screenshots/overview-light.png'
import { SITE } from '../lib/site'
import Screenshot from './Screenshot.astro';
---

<section class="relative overflow-hidden border-b border-border">
  {/* control-room grid, faded by a radial mask */}
  <div
    class="app-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(120%_80%_at_50%_0%,black,transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative mx-auto max-w-7xl px-5 pt-20 pb-16 text-center sm:px-8 sm:pt-28"
  >
    <h1
      class="reveal mx-auto max-w-4xl text-balance text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl"
      style="--reveal-delay: 80ms"
    >
      Your Playwright tests,<br class="hidden sm:block" />
      <span class="text-muted-foreground">across projects and over time.</span>
    </h1>

    <p
      class="reveal mx-auto mt-6 max-w-2xl text-pretty text-lg text-muted-foreground"
      style="--reveal-delay: 160ms"
    >
      Playwright ships a great report for a single run. kinora sits one level
      up: push every CI run, from Playwright, Vitest browser mode or Storybook,
      and get one place to track pass rates, spot trends, surface flaky tests,
      and open the full trace inline.
    </p>

    <div
      class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
      style="--reveal-delay: 240ms"
    >
      <a
        href={SITE.signup}
        data-umami-event="get-started-hero"
        class="inline-flex h-11 items-center gap-2 rounded-md bg-signal px-6 text-sm font-semibold text-background transition-opacity hover:opacity-90"
      >
        Get started
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
      <a
        href={SITE.demo}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="live-demo-hero"
        class="inline-flex h-11 items-center gap-2 rounded-md border border-border px-6 text-sm font-semibold transition-colors hover:bg-muted bg-background"
      >
        <Play class="size-4" aria-hidden="true" />
        Live demo
      </a>
    </div>
    <p
      class="reveal mt-5 text-sm text-muted-foreground"
      style="--reveal-delay: 240ms"
    >
      Free to self-host from <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="github-hero"
        class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
                             >GitHub</a
      >, or use kinora cloud.
    </p>

    <div class="reveal mt-16 sm:mt-20" style="--reveal-delay: 120ms">
      <Screenshot
        light={overviewLight}
        dark={overviewDark}
        loading="eager"
        alt="kinora dashboard showing test runs overview with pass rates and per-run strips across projects"
        class="mx-auto max-w-5xl"
      />
    </div>
  </div>
</section>
