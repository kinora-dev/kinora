---
import hankenLatin from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url'
import jetbrainsLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import { SITE } from '../lib/site'
import '@fontsource-variable/hanken-grotesk'
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  pathname?: string
  robots?: string
  image?: string
  schemas?: Record<string, unknown>[]
}

const site = Astro.site ?? new URL(SITE.url)
const {
  title = `${SITE.name} - ${SITE.tagline}`,
  description = SITE.description,
  pathname = Astro.url.pathname,
  robots = 'index,follow',
  image = '/og-image.png',
  schemas = [],
} = Astro.props

const canonical = new URL(pathname, site).toString()
const imageUrl = new URL(image, site).toString()

const isProd = import.meta.env.MODE === 'production'

const orgId = `${site.origin}/#organization`
const siteId = `${site.origin}/#website`

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      'name': SITE.name,
      'url': site.toString(),
      'logo': new URL('/web-app-manifest-512x512.png', site).toString(),
      'sameAs': [SITE.repo],
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      'name': SITE.name,
      'url': site.toString(),
      'publisher': { '@id': orgId },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site.origin}/#software`,
      'name': SITE.name,
      'description': SITE.description,
      'url': site.toString(),
      'applicationCategory': 'DeveloperApplication',
      'applicationSubCategory': 'Test reporting',
      'operatingSystem': 'Web, macOS, Windows, Linux, self-hosted',
      'publisher': { '@id': orgId },
      'sameAs': [SITE.repo],
      'softwareHelp': SITE.docs,
      'downloadUrl': SITE.download,
      'license': 'https://fsl.software/',
      'isAccessibleForFree': true,
      'keywords': 'Playwright, test report, test dashboard, flaky tests, trace viewer, CI',
      'featureList': [
        'Playwright test dashboard across projects and over time',
        'Pass-rate and trend tracking',
        'Flaky test detection',
        'Embedded Playwright trace viewer',
        'Self-hosted or cloud',
      ],
      'offers': {
        '@type': 'AggregateOffer',
        'priceCurrency': 'USD',
        'lowPrice': '0',
        'highPrice': '149',
        'offerCount': '4',
        'offers': [
          { '@type': 'Offer', 'name': 'Self-hosted', 'price': '0', 'priceCurrency': 'USD' },
          { '@type': 'Offer', 'name': 'Free', 'price': '0', 'priceCurrency': 'USD' },
          { '@type': 'Offer', 'name': 'Team', 'price': '49', 'priceCurrency': 'USD' },
          { '@type': 'Offer', 'name': 'Pro', 'price': '149', 'priceCurrency': 'USD' },
        ],
      },
    },
    ...schemas,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0b"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="kinora blog" href="/rss.xml" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={hankenLatin}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={jetbrainsLatin}
      crossorigin
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="kinora" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <meta property="og:site_name" content="kinora" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} - ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`${SITE.name} - ${SITE.tagline}`} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <slot />

    <script is:inline>
const els = document.querySelectorAll('.reveal')
if (els.length && 'IntersectionObserver' in window) {
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible')
          io.unobserve(e.target)
        }
      }
    },
    { threshold: 0.12 },
  )
  els.forEach(el => io.observe(el))
}
else {
  els.forEach(el => el.classList.add('is-visible'))
}
</script>
    {
      isProd && (
        <script
          is:inline
          defer
          src="https://analytics.jorisgallot.dev/j.js"
          data-website-id="910fe634-7e37-486a-80d4-831bbecbf3da"
        />
      )
    }
  </body>
</html>
