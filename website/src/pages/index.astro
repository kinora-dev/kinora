---
import CtaSection from '../components/CtaSection.astro'
import FaqSection from '../components/FaqSection.astro'
import HeroSection from '../components/HeroSection.astro'
import PillarSection from '../components/PillarSection.astro'
import PricingSection from '../components/PricingSection.astro'
import SecondaryFeatures from '../components/SecondaryFeatures.astro'
import SetupSection from '../components/SetupSection.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import TraceSection from '../components/TraceSection.astro'
import WorkflowSection from '../components/WorkflowSection.astro'
import { HOME_FAQS } from '../data/faq'
import { COVER, UNDERSTAND } from '../data/pillars'
import Layout from '../layouts/Layout.astro'

const schemas = [
  {
    '@type': 'FAQPage',
    'mainEntity': HOME_FAQS.map(f => ({
      '@type': 'Question',
      'name': f.q,
      'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
    })),
  },
];
---

<Layout
  title="kinora - Playwright test dashboard: history, flaky tracking, inline trace viewer"
  description="Open-source dashboard for Playwright tests across runs. Track pass rate and trends, surface flaky tests, and open the full trace inline. Self-host free or use the cloud."
  schemas={schemas}
>
  <SiteHeader />
  <main>
    <HeroSection />
    <PillarSection pillar={UNDERSTAND} />
    <TraceSection eyebrow="Debug" />
    <WorkflowSection />
    <PillarSection pillar={COVER} />
    <SecondaryFeatures />
    <SetupSection />
    <PricingSection />
    <FaqSection />
    <CtaSection />
  </main>
  <SiteFooter />
</Layout>
