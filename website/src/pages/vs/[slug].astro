---
import { ArrowRight, Check as CheckIcon, ChevronDown, Minus } from '@lucide/astro'
import CtaSection from '../../components/CtaSection.astro'
import GithubIcon from '../../components/GithubIcon.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import { COMPARISONS } from '../../data/comparisons'
import Layout from '../../layouts/Layout.astro'
import { SITE } from '../../lib/site'

export function getStaticPaths() {
  return COMPARISONS.map(c => ({ params: { slug: c.slug }, props: { c } }))
}

const { c } = Astro.props
const site = Astro.site ?? new URL(SITE.url)

const others = COMPARISONS.filter(o => o.slug !== c.slug)

const schemas = [
  {
    '@type': 'FAQPage',
    'mainEntity': c.faqs.map(f => ({
      '@type': 'Question',
      'name': f.q,
      'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'kinora', 'item': site.toString() },
      { '@type': 'ListItem', 'position': 2, 'name': 'Comparisons', 'item': new URL('/vs', site).toString() },
      { '@type': 'ListItem', 'position': 3, 'name': `vs ${c.themShort}`, 'item': new URL(`/vs/${c.slug}`, site).toString() },
    ],
  },
]
---

<Layout
  title={c.title}
  description={c.description}
  pathname={`/vs/${c.slug}`}
  schemas={schemas}
>
  <SiteHeader />
  <main>
    <section class="relative overflow-hidden border-b border-border">
      <div
        class="app-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(120%_80%_at_50%_0%,black,transparent)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-4xl px-5 pt-16 pb-14 text-center sm:px-8 sm:pt-24">
        <nav
          class="reveal mb-6 font-mono text-[11px] uppercase tracking-wider text-muted-foreground"
          aria-label="Breadcrumb"
        >
          <a href="/" class="transition-colors hover:text-foreground">kinora</a>
          <span class="px-1.5" aria-hidden="true">/</span>
          <a href="/vs" class="transition-colors hover:text-foreground">Compare</a>
          <span class="px-1.5" aria-hidden="true">/</span>
          <span class="text-foreground">vs {c.themShort}</span>
        </nav>
        <h1
          class="reveal text-balance text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl"
          style="--reveal-delay: 60ms"
        >
          kinora <span class="text-muted-foreground">vs</span> {c.themShort}
        </h1>
        <p
          class="reveal mx-auto mt-6 max-w-2xl text-pretty text-lg text-muted-foreground"
          style="--reveal-delay: 140ms"
        >
          {c.tldr}
        </p>
        <div
          class="reveal mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
          style="--reveal-delay: 220ms"
        >
          <a
            href={SITE.signup}
            data-umami-event={`get-started-vs-${c.slug}`}
            class="inline-flex h-11 items-center gap-2 rounded-md bg-signal px-6 font-mono text-sm font-semibold text-background transition-opacity hover:opacity-90"
          >
            Get started
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
          <a
            href={SITE.demo}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event={`live-demo-vs-${c.slug}`}
            class="inline-flex h-11 items-center gap-2 rounded-md border border-border px-6 font-mono text-sm font-semibold transition-colors hover:bg-muted bg-background"
          >
            Live demo
          </a>
        </div>
      </div>
    </section>

    {/* What each is */}
    <section class="border-b border-border">
      <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
        <p class="reveal max-w-3xl text-pretty text-lg leading-relaxed text-muted-foreground">
          {c.intro}
        </p>
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          <div class="reveal rounded-xl border border-signal/40 bg-card/40 p-6 ring-1 ring-signal/20">
            <h2 class="font-mono text-sm font-semibold uppercase tracking-wider text-signal">
              kinora
            </h2>
            <p class="mt-3 text-pretty leading-relaxed text-muted-foreground">{c.kinoraIs}</p>
          </div>
          <div class="reveal rounded-xl border border-border bg-card/40 p-6" style="--reveal-delay: 80ms">
            <h2 class="font-mono text-sm font-semibold uppercase tracking-wider text-foreground">
              {c.themShort}
            </h2>
            <p class="mt-3 text-pretty leading-relaxed text-muted-foreground">{c.themIs}</p>
          </div>
        </div>
      </div>
    </section>

    {/* Feature table */}
    <section class="border-b border-border">
      <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
        <h2 class="reveal text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
          Feature by feature
        </h2>
        <div class="reveal mt-8 overflow-x-auto rounded-xl border border-border" style="--reveal-delay: 80ms">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-border bg-card/40">
                <th class="px-5 py-4 text-left font-medium text-muted-foreground" scope="col">Feature</th>
                <th class="px-5 py-4 text-left font-mono text-xs font-semibold uppercase tracking-wider text-signal" scope="col">kinora</th>
                <th class="px-5 py-4 text-left font-mono text-xs font-semibold uppercase tracking-wider text-muted-foreground" scope="col">{c.themShort}</th>
              </tr>
            </thead>
            <tbody>
              {
                c.rows.map((row, i) => (
                  <tr class:list={['border-b border-border/60 last:border-0', i % 2 === 1 && 'bg-card/20']}>
                    <th class="px-5 py-3.5 text-left font-normal text-foreground" scope="row">{row.label}</th>
                    <td class="px-5 py-3.5 bg-signal/[0.04]">
                      {typeof row.kinora === 'boolean'
                        ? row.kinora
                          ? <CheckIcon class="size-4 text-signal" aria-label="Yes" />
                          : <Minus class="size-4 text-muted-foreground/60" aria-label="No" />
                        : <span class="text-foreground">{row.kinora}</span>}
                    </td>
                    <td class="px-5 py-3.5">
                      {typeof row.them === 'boolean'
                        ? row.them
                          ? <CheckIcon class="size-4 text-muted-foreground" aria-label="Yes" />
                          : <Minus class="size-4 text-muted-foreground/60" aria-label="No" />
                        : <span class="text-muted-foreground">{row.them}</span>}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* Choose which */}
    <section class="border-b border-border">
      <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
        <h2 class="reveal text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
          Which should you pick?
        </h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div class="reveal rounded-xl border border-signal/40 bg-card/40 p-6 ring-1 ring-signal/20">
            <h3 class="font-mono text-sm font-semibold uppercase tracking-wider text-signal">Choose kinora when</h3>
            <ul class="mt-4 flex flex-col gap-3 text-sm">
              {c.chooseKinora.map(item => (
                <li class="flex gap-2.5 text-muted-foreground">
                  <CheckIcon class="mt-0.5 size-4 shrink-0 text-signal" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="reveal rounded-xl border border-border bg-card/40 p-6" style="--reveal-delay: 80ms">
            <h3 class="font-mono text-sm font-semibold uppercase tracking-wider text-foreground">{c.chooseThemLabel}</h3>
            <ul class="mt-4 flex flex-col gap-3 text-sm">
              {c.chooseThem.map(item => (
                <li class="flex gap-2.5 text-muted-foreground">
                  <ArrowRight class="mt-0.5 size-4 shrink-0 text-muted-foreground/70" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="border-b border-border">
      <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-20">
        <h2 class="reveal text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
          FAQ
        </h2>
        <div class="reveal mt-8 flex flex-col gap-px overflow-hidden rounded-xl border border-border bg-border" style="--reveal-delay: 80ms">
          {
            c.faqs.map(f => (
              <details class="group bg-background">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left font-medium tracking-tight transition-colors hover:bg-muted/40 [&::-webkit-details-marker]:hidden">
                  <span>{f.q}</span>
                  <ChevronDown class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true" />
                </summary>
                <p class="px-6 pb-5 text-pretty leading-relaxed text-muted-foreground">{f.a}</p>
              </details>
            ))
          }
        </div>

        <div class="reveal mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
          <span class="font-mono text-[11px] uppercase tracking-wider">Also compare:</span>
          {
            others.map(o => (
              <a
                href={`/vs/${o.slug}`}
                class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
              >
                vs {o.themShort}
              </a>
            ))
          }
        </div>

        <div class="reveal mt-6 flex flex-wrap items-center gap-4 text-sm">
          <a href={SITE.repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground">
            <GithubIcon class="size-3.5" /> Source on GitHub
          </a>
          <span class="text-border" aria-hidden="true">&middot;</span>
          <a href="/#pricing" class="text-muted-foreground transition-colors hover:text-foreground">Pricing</a>
          <span class="text-border" aria-hidden="true">&middot;</span>
          <a href="/#faq" class="text-muted-foreground transition-colors hover:text-foreground">More FAQs</a>
          <span class="text-border" aria-hidden="true">&middot;</span>
          <a href={SITE.docs} data-umami-event="docs-vs" class="text-muted-foreground transition-colors hover:text-foreground">Docs</a>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>
  <SiteFooter />
</Layout>
