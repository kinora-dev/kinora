---
import { House, Search } from '@lucide/astro'
import DocsSearch from '../components/DocsSearch.astro'
import GithubIcon from '../components/GithubIcon.astro'
import Wordmark from '../components/Wordmark.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/site'
---

<BaseLayout
  title="Page not found - kinora docs"
  description="The page you are looking for does not exist."
  robots="noindex,follow"
>
  <main class="relative grid min-h-screen place-items-center overflow-hidden px-5 py-12">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-64 bg-[radial-gradient(circle_at_top,color-mix(in_oklch,var(--signal)_18%,transparent),transparent_60%)]" aria-hidden="true"></div>

    <section class="relative w-full max-w-2xl rounded-2xl border border-border bg-card/70 p-8 text-center shadow-2xl shadow-black/5 backdrop-blur sm:p-12">
      <a href="/" class="mx-auto inline-flex items-center gap-2.5" aria-label="kinora docs home">
        <Wordmark />
        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">docs</span>
      </a>

      <p class="mt-10 font-mono text-xs font-medium uppercase tracking-[0.24em] text-signal">404</p>
      <h1 class="mt-3 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
        This docs page does not exist or may have moved. Head back to the docs home, or search for what you need.
      </p>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          <House class="size-4" aria-hidden="true" />
          Go to docs home
        </a>
        <button
          id="docs-search-open"
          type="button"
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:border-signal/50 hover:bg-muted/50"
        >
          <Search class="size-4" aria-hidden="true" />
          Search docs
        </button>
      </div>

      <div class="mt-10 flex justify-center gap-5 text-sm text-muted-foreground">
        <a href={SITE.home} class="transition-colors hover:text-foreground">kinora.dev</a>
        <a href={SITE.repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground">
          <GithubIcon class="size-4" />
          GitHub
        </a>
      </div>
    </section>
  </main>

  <DocsSearch />
</BaseLayout>
