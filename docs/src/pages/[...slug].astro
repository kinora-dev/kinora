---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../layouts/DocsLayout.astro'
import { markdownHrefFor, slugOf } from '../lib/markdown'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries.map(entry => ({ params: { slug: slugOf(entry) || undefined }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const editPath = `docs/src/content/docs/${entry.id}.md`
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  headings={headings}
  editPath={editPath}
  markdownHref={markdownHrefFor(slugOf(entry))}
>
  <Content />
</DocsLayout>
