---
import { Menu, Search, X } from '@lucide/astro'
import DocsSearch from '../components/DocsSearch.astro'
import GithubIcon from '../components/GithubIcon.astro'
import Wordmark from '../components/Wordmark.astro'
import { hrefFor, NAV, neighbors } from '../lib/nav'
import { SITE } from '../lib/site'
import BaseLayout from './BaseLayout.astro'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  description?: string
  section?: string
  headings: Heading[]
  editPath?: string
}

const { title, description, headings, editPath } = Astro.props

const norm = (h: string) => h.replace(/\/+$/, '') || '/'
const here = norm(Astro.url.pathname)
// Home title is already self-describing; inner pages get the site suffix.
const docTitle = here === '/' ? title : `${title} - kinora docs`
const activeItem = NAV.flatMap(g => g.items).find(it => norm(hrefFor(it.slug)) === here)
const { prev, next } = activeItem ? neighbors(activeItem.slug) : {}

const activeGroup = NAV.find(g => g.items.some(it => norm(hrefFor(it.slug)) === here))
const abs = (path: string) => new URL(path, SITE.url).toString()

// Every breadcrumb entry but the last needs an `item` URL, so the group level is only
// listed when the group has its own index page and we are not already standing on it.
const groupIndex = activeGroup?.items.find(it => activeGroup.items.every(o => o === it || o.slug.startsWith(`${it.slug}/`)))
const groupHref = groupIndex && norm(hrefFor(groupIndex.slug)) !== here ? hrefFor(groupIndex.slug) : null
const groupCrumb = activeGroup?.label && groupHref
  ? [{ '@type': 'ListItem', 'position': 2, 'name': activeGroup.label, 'item': abs(groupHref) }]
  : []

const breadcrumb = here === '/'
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Docs', 'item': abs('/') },
        ...groupCrumb,
        { '@type': 'ListItem', 'position': groupCrumb.length ? 3 : 2, 'name': title, 'item': abs(Astro.url.pathname) },
      ],
    }

const toc = headings.filter(h => h.depth === 2 || h.depth === 3)
const editUrl = editPath ? `${SITE.repo}/edit/main/${editPath}` : SITE.repo
---

<BaseLayout title={docTitle} description={description}>
  {breadcrumb && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  )}
  <div class="min-h-screen">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-border/80 bg-background/85 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-[1400px] items-center gap-4 px-5 sm:px-8">
        <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="kinora docs home">
          <Wordmark size="sm" />
          <span class="hidden font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground sm:inline">
            docs
          </span>
        </a>

        <button
          id="docs-search-open"
          type="button"
          aria-label="Search docs"
          class="ml-auto flex h-9 w-full max-w-64 items-center gap-2 rounded-md border border-border bg-card/50 px-3 text-sm text-muted-foreground transition-colors hover:border-signal/50 hover:text-foreground lg:ml-6"
        >
          <Search class="size-4 shrink-0" aria-hidden="true" />
          <span>Search</span>
          <kbd class="ml-auto rounded border border-border px-1.5 py-0.5 font-mono text-[10px]">⌘K</kbd>
        </button>

        <div class="ml-auto flex shrink-0 items-center gap-1">
          <a
            href={SITE.repo}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="github"
            class="grid size-9 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            aria-label="kinora on GitHub"
          >
            <GithubIcon class="size-4" />
          </a>
          <a
            href={SITE.home}
            class="hidden h-9 items-center rounded-md px-3 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:inline-flex"
          >
            kinora.dev
          </a>
          <button
            id="docs-menu-btn"
            type="button"
            aria-label="Open menu"
            aria-controls="docs-mobile-nav"
            aria-expanded="false"
            class="group grid size-9 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground lg:hidden"
          >
            <Menu class="size-4 group-aria-expanded:hidden" aria-hidden="true" />
            <X class="hidden size-4 group-aria-expanded:block" aria-hidden="true" />
          </button>
        </div>
      </div>

      <!-- Mobile nav -->
      <nav
        id="docs-mobile-nav"
        hidden
        aria-label="Docs (mobile)"
        class="max-h-[70vh] overflow-y-auto border-t border-border/80 bg-background px-5 py-4 lg:hidden"
      >
        {NAV.map(group => (
          <div class="mb-5">
            {group.label && (
              <p class="mb-2 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-muted-foreground/80">
                {group.label}
              </p>
            )}
            <ul class="space-y-0.5">
              {group.items.map((item) => {
                const active = norm(hrefFor(item.slug)) === here
                return (
                  <li>
                    <a
                      href={hrefFor(item.slug)}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'block rounded-md px-3 py-2 text-sm transition-colors',
                        active ? 'bg-muted/70 font-medium text-foreground' : 'text-muted-foreground hover:bg-muted/50 hover:text-foreground',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        ))}
      </nav>
    </header>

    <div class="mx-auto grid max-w-[1400px] grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] xl:grid-cols-[240px_minmax(0,1fr)_220px]">
      <!-- Sidebar -->
      <aside class="hidden border-r border-border/70 lg:block">
        <nav class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto px-4 py-8" aria-label="Docs">
          {NAV.map(group => (
            <div class="mb-7">
              {group.label && (
                <p class="mb-2 px-2 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-muted-foreground/80">
                  {group.label}
                </p>
              )}
              <ul class="space-y-0.5">
                {group.items.map((item) => {
                  const active = norm(hrefFor(item.slug)) === here
                  return (
                    <li>
                      <a
                        href={hrefFor(item.slug)}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                          'group relative flex items-center rounded-md py-1.5 pl-3 pr-2 text-sm transition-colors',
                          active ? 'bg-muted/70 font-medium text-foreground' : 'text-muted-foreground hover:bg-muted/50 hover:text-foreground',
                        ]}
                      >
                        {active && (
                          <span class="absolute left-0 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-full bg-signal" aria-hidden="true"></span>
                        )}
                        {item.label}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Content -->
      <main class="min-w-0 px-5 py-10 sm:px-10 lg:py-14">
        <article class="docs-prose mx-auto max-w-3xl" data-pagefind-body>
          {here !== '/' && (
            <nav aria-label="Breadcrumb" class="mb-3 flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.16em]">
              <a href="/" class="text-muted-foreground transition-colors hover:text-foreground">Docs</a>
              {activeGroup?.label && (
                <>
                  <span class="text-muted-foreground/50" aria-hidden="true">/</span>
                  <span class="font-medium text-signal">{activeGroup.label}</span>
                </>
              )}
            </nav>
          )}
          <h1 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
          {description && (
            <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{description}</p>
          )}
          <div class="my-8 h-px bg-border"></div>

          <slot />

          {(prev || next) && (
            <nav class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2">
              {prev
                ? (
                    <a href={hrefFor(prev.slug)} class="group rounded-lg border border-border bg-card/40 px-4 py-3 transition-colors hover:border-signal/50">
                      <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground">Previous</span>
                      <span class="mt-1 block text-sm font-medium text-foreground group-hover:text-signal">{prev.label}</span>
                    </a>
                  )
                : <span></span>}
              {next && (
                <a href={hrefFor(next.slug)} class="group rounded-lg border border-border bg-card/40 px-4 py-3 text-right transition-colors hover:border-signal/50 sm:col-start-2">
                  <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground">Next</span>
                  <span class="mt-1 block text-sm font-medium text-foreground group-hover:text-signal">{next.label}</span>
                </a>
              )}
            </nav>
          )}
        </article>
      </main>

      <!-- On this page -->
      <aside class="hidden xl:block">
        <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto px-4 py-14">
          {toc.length > 0 && (
            <>
              <p class="mb-3 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-muted-foreground/80">
                On this page
              </p>
              <ul class="space-y-1.5 border-l border-border/70">
                {toc.map(h => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link={h.slug}
                      class:list={[
                        '-ml-px block border-l border-transparent py-0.5 text-[13px] leading-snug text-muted-foreground transition-colors hover:text-foreground',
                        h.depth === 3 ? 'pl-6' : 'pl-4',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={editUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block border-l border-border/70 pl-4 text-[13px] text-muted-foreground transition-colors hover:text-signal">
                Edit this page →
              </a>
            </>
          )}
        </div>
      </aside>
    </div>

    <DocsSearch />
  </div>

  <script is:inline>
    // Mobile nav toggle
    const mBtn = document.getElementById('docs-menu-btn')
    const mNav = document.getElementById('docs-mobile-nav')
    if (mBtn && mNav) {
      const close = () => {
        mNav.setAttribute('hidden', '')
        mBtn.setAttribute('aria-expanded', 'false')
        mBtn.setAttribute('aria-label', 'Open menu')
      }
      mBtn.addEventListener('click', () => {
        if (mNav.hasAttribute('hidden')) {
          mNav.removeAttribute('hidden')
          mBtn.setAttribute('aria-expanded', 'true')
          mBtn.setAttribute('aria-label', 'Close menu')
        }
        else { close() }
      })
      mNav.querySelectorAll('a').forEach(a => a.addEventListener('click', close))
    }

    // TOC scroll-spy
    const links = document.querySelectorAll('[data-toc-link]')
    if (links.length) {
      const byId = new Map()
      links.forEach(l => byId.set(l.getAttribute('data-toc-link'), l))
      const heads = [...byId.keys()].map(id => document.getElementById(id)).filter(Boolean)
      let current = null
      const activate = (id) => {
        if (id === current)
          return
        current = id
        links.forEach(l => l.removeAttribute('data-active'))
        byId.get(id)?.setAttribute('data-active', '')
      }
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            activate(e.target.id)
            break
          }
        }
      }, { rootMargin: '-72px 0px -70% 0px', threshold: 0 })
      heads.forEach(h => io.observe(h))
    }
  </script>
</BaseLayout>
