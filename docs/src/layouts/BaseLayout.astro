---
import { SITE } from '../lib/site'
import '@fontsource-variable/hanken-grotesk'
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  robots?: string
}

const site = Astro.site ?? new URL(SITE.url)
const { title, description = SITE.description, robots = 'index,follow' } = Astro.props
const canonical = new URL(Astro.url.pathname, site).toString()
const ogImage = new URL('/og-image.png', site).toString()

const isProd = import.meta.env.MODE === 'production'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="kinora docs" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content="kinora docs" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="kinora docs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        'name': 'kinora docs',
        'url': site.toString(),
        'publisher': { '@type': 'Organization', 'name': 'kinora', 'url': SITE.home },
      })}
    />
  </head>
  <body>
    <slot />
    {
      isProd && (
        <>
          <script
            is:inline
            defer
            src="https://sonar.jorisgallot.dev/script.js"
            data-website-id="163e0b73-1ee2-488b-9645-3fc7ca916a19"
          />
          <script is:inline>
            document.addEventListener('click', (e) => {
              const link = e.target instanceof Element ? e.target.closest('a[href^="https://app.kinora.dev"]') : null
              if (link && window.umami)
                window.umami.track('to-app', { from: location.pathname })
            })
          </script>
        </>
      )
    }
  </body>
</html>
