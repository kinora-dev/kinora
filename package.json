{
  "name": "kinora",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "A dashboard for your Playwright reports, across projects and over time",
  "license": "FSL-1.1-MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @kinora/web dev",
    "dev:viewer": "pnpm --filter @kinora/trace-viewer dev",
    "dev:server": "pnpm --filter @kinora/server dev",
    "build": "pnpm -r build",
    "preview:web": "pnpm --filter @kinora/web preview",
    "preview:viewer": "pnpm --filter @kinora/trace-viewer preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm -r test:e2e",
    "vendor:playwright-trace": "node scripts/vendor-playwright-trace-viewer.mjs",
    "vendor:playwright-trace:check": "node scripts/vendor-playwright-trace-viewer.mjs --check"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "~6.0.3"
  }
}
