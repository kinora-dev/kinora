{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // ESNext.Temporal: the vendored injected script feature-detects `window.Temporal` (upstream compiles with ESNext).
    "lib": ["ES2023", "ESNext.Temporal", "DOM", "DOM.Iterable", "WebWorker"],
    // Aliases kept identical to upstream so vendored files compile unedited
    // and re-syncing from microsoft/playwright stays a plain re-copy.
    "paths": {
      "@trace/*": ["./src/core/trace/*"],
      "@isomorphic/*": ["./src/core/isomorphic/*"],
      "@injected/*": ["./src/core/injected/*"],
      "@recorder/*": ["./src/core/recorder/*"],
      "@protocol/*": ["./src/core/protocol/*"],
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"],
    // Vendored upstream code: don't fight its style with our lint-level tsc flags.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Match upstream tsconfig so vendored files compile unedited.
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  // Template checks off by default in vue-tsc: an unimported component, an undeclared event or an
  // unknown directive otherwise only shows up as a Vue warning at runtime.
  "vueCompilerOptions": {
    "checkUnknownComponents": true,
    "checkUnknownEvents": true,
    "checkUnknownDirectives": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts", "e2e/**/*.ts"]
}
