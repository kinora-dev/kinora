{
  "name": "@kinora/trace-viewer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright trace replay engine (vendored from microsoft/playwright, Apache-2.0) plus kinora's own UI",
  "author": "Joris Gallot",
  "license": "MIT",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "fixtures:generate": "node scripts/generate-trace-fixtures.mjs",
    "build:sw": "vite build --config vite.sw.config.ts",
    "dev": "pnpm build:sw && vite",
    "build": "pnpm build:sw && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@kinora/ui": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.61.0",
    "@sentry/vue": "^11.8.0",
    "@tanstack/vue-table": "^9.3.1",
    "@vueuse/core": "^15.0.0",
    "@zip.js/zip.js": "2.7.29",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
