{
  "name": "@kinora/trace-viewer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright trace replay engine (vendored from microsoft/playwright, Apache-2.0) plus kinora's own UI",
  "author": "Joris Gallot",
  "license": "MIT",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:sw": "vite build --config vite.sw.config.ts",
    "dev": "pnpm build:sw && vite",
    "build": "pnpm build:sw && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@kinora/ui": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.45.0",
    "@sentry/vue": "^10.74.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.4.0",
    "@zip.js/zip.js": "2.7.29",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
