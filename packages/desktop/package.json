{
  "name": "@kinora/desktop",
  "productName": "kinora",
  "type": "module",
  "version": "0.19.0",
  "private": true,
  "description": "kinora desktop: cloud dashboard + local Playwright trace viewer (Electron).",
  "author": "Joris Gallot",
  "license": "FSL-1.1-MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown && vite build -c home/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p home/tsconfig.json",
    "test": "vitest run",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "probe": "KINORA_DESKTOP_PROBE=1 electron .",
    "probe:home": "KINORA_HOME_PROBE=1 electron .",
    "dist:mac": "pnpm --filter @kinora/trace-viewer build && pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@kinora/core": "workspace:*",
    "@kinora/trace-viewer": "workspace:*",
    "@kinora/ui": "workspace:*",
    "@lucide/vue": "^1.61.0",
    "@sentry/electron": "^7.20.2",
    "@trpc/client": "^11.22.1",
    "@trpc/server": "11.22.1",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@kinora/server": "workspace:*",
    "@sentry/vite-plugin": "^11.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
