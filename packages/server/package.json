{
  "name": "@kinora/server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Kinora backend: Hono + tRPC API (single-tenant, self-hostable)",
  "author": "Joris Gallot",
  "license": "FSL-1.1-MIT",
  "exports": {
    ".": "./src/router/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:create": "tsx scripts/db-create.ts",
    "db:reset:e2e": "tsx scripts/reset-e2e.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:market": "tsx scripts/seed-market.ts",
    "migrate": "tsx scripts/migrate.ts",
    "purge-expired-runs": "tsx scripts/purge-expired-runs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@better-auth/api-key": "^1.7.4",
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@hono/zod-validator": "^0.8.0",
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/sdk": "^0.48.1",
    "@sentry/node": "^10.74.0",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.4",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "knex": "^3.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@kinora/core": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
