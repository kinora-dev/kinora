NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Cross-subdomain cookie (prod cloud: app. <-> api.). Required only when KINORA_CLOUD=true
# in production. Leave empty for local dev (localhost shares cookies) and single-origin self-host.
COOKIE_DOMAIN=
AUTH_SECRET=change-me-with-a-long-random-string

POSTGRES_USER=kinora
POSTGRES_PASSWORD=kinora
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_DB=kinora

# Ingest requests per minute per client IP (DoS backstop). Default 600. Raise it if a single
# unsharded CI runner uploads hundreds of traces per minute.
INGEST_RATE_LIMIT=600

# Dashboard (tRPC) requests per minute per client IP. Default 300. Raise it if many users
# reach the server through one IP (office NAT, a proxy that doesn't forward the client IP).
TRPC_RATE_LIMIT=300

# Artifact storage (trace.zip + attachments).
# Leave the S3_* vars empty to store on local disk under STORAGE_DIR.
# Set all five S3_* to use any S3-compatible store (AWS, R2, MinIO, Hetzner); STORAGE_DIR is then ignored.
STORAGE_DIR=.data/artifacts
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Retention sweep (self-host only; cloud retention follows the plan tier). 0 = keep forever.
# The server runs a daily in-process sweep as soon as one of them is non-zero.
# KINORA_ARTIFACT_RETENTION_DAYS is the space-efficient one: it deletes stored trace.zip files
# (screenshots and videos ride inside them) while keeping the runs, so history and trends stay.
KINORA_ARTIFACT_RETENTION_DAYS=0
# These two delete whole runs, history included. KINORA_KEEP_LAST_RUNS counts per project.
KINORA_RETENTION_DAYS=0
KINORA_KEEP_LAST_RUNS=0

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloud mode: true enables Polar billing. Self-host leaves this false
KINORA_CLOUD=false

# Polar (required only when KINORA_CLOUD=true)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_TEAM_ID=
POLAR_PRODUCT_PRO_ID=

# Slack "Add to Slack" OAuth app. Leave empty to fall back to manual webhook-URL paste.
# Redirect URL to register in the Slack app: ${BASE_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# SMTP for transactional email (password reset, email verification, invitations).
# Leave empty to disable email flows; any provider works (Resend, Brevo, SES, self-hosted).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="kinora <no-reply@example.dev>"

# Sentry error reporting. Only active when KINORA_CLOUD=true AND NODE_ENV=production. Leave empty to disable.
SENTRY_DSN=

# Private task tracker for in-app "Send feedback". Only active when KINORA_CLOUD=true and all four are set.
# Kinora Cloud uses Kaneo, but the names stay generic because self-host instances should leave them empty.
FEEDBACK_TRACKER_API_KEY=
FEEDBACK_TRACKER_PROJECT_ID=
FEEDBACK_TRACKER_WORKSPACE_ID=
FEEDBACK_TRACKER_API_URL=
