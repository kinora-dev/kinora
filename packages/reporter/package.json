{
  "name": "@kinora/reporter",
  "type": "module",
  "version": "0.10.0",
  "description": "Playwright reporter that uploads test results to a kinora server",
  "author": "Joris Gallot",
  "license": "MIT",
  "homepage": "https://github.com/kinora-dev/kinora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinora-dev/kinora.git",
    "directory": "packages/reporter"
  },
  "bugs": "https://github.com/kinora-dev/kinora/issues",
  "keywords": [
    "playwright",
    "reporter",
    "test-report",
    "ci",
    "kinora"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./ct": "./dist/ct.mjs",
    "./a11y": "./dist/a11y.mjs"
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.20.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4.13.0",
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "@kinora/core": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
