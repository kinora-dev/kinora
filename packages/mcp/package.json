{
  "name": "@kinora/mcp",
  "type": "module",
  "version": "0.2.0",
  "description": "MCP server exposing kinora test failures and history (Playwright, Vitest, Storybook) to coding agents",
  "author": "Joris Gallot",
  "license": "MIT",
  "homepage": "https://github.com/kinora-dev/kinora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinora-dev/kinora.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/kinora-dev/kinora/issues",
  "keywords": [
    "playwright",
    "vitest",
    "storybook",
    "test-report",
    "flaky-tests",
    "ci",
    "dashboard",
    "mcp",
    "model-context-protocol"
  ],
  "bin": {
    "kinora-mcp": "./dist/mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.20.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@kinora/core": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
